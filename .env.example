# Database Configuration
DATABASE_URL_ASYNC=postgresql+asyncpg://username:password@localhost:5432/drum_notation_db
DATABASE_URL_SYNC=postgresql://username:password@localhost:5432/drum_notation_db

# Security Settings
SECRET_KEY=your-super-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI Configuration (for AI enrichment features)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Development Settings
DEBUG=True

# File Storage Settings
UPLOAD_DIR=uploads
MAX_FILE_SIZE=104857600

# Optional: Additional API Keys
# GOOGLE_API_KEY=your-google-api-key
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# =========================
# 2FA / OTP Settings
# =========================
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_LOGIN_RATE_LIMIT_PER_HOUR=10
OTP_VERIFY_RATE_LIMIT_PER_MINUTE=10
CHALLENGE_TOKEN_EXPIRE_MINUTES=10

# Set to True for local development to log OTPs instead of sending email
OTP_EMAIL_DEBUG=False

# =========================
# SMTP Settings (email delivery for OTP)
# =========================
# Examples:
#   Gmail (App Password):  host=smtp.gmail.com   port=587  TLS=True  SSL=False
#   SendGrid:              host=smtp.sendgrid.net port=587  TLS=True  SSL=False
#                          username=apikey       password=<API_KEY>
#   Mailgun:               host=smtp.mailgun.org port=587  TLS=True  SSL=False
#   Implicit SSL (legacy): port=465              TLS=False SSL=True
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-user@example.com
SMTP_PASSWORD=your-smtp-password-or-app-password
SMTP_FROM=no-reply@yourdomain.com
SMTP_FROM_NAME=Drum Notation
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_TIMEOUT=20
